{
  "name": "fifa-wc-2026",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "seed:generate": "npx vite-node scripts/seed-fixtures.ts",
    "seed:fixtures": "npx vite-node scripts/seed-fixtures.ts && npx wrangler d1 execute fifa-wc-2026 --local --file=scripts/seed-fixtures.sql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx wrangler d1 migrations apply fifa-wc-2026 --local"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^6.0.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "better-auth": "^1.6.10",
    "drizzle-orm": "^0.45.2",
    "resend": "^6.12.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260509.1",
    "@tailwindcss/vite": "^4.1.0",
    "drizzle-kit": "^0.31.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
