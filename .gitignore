# Dependencies
node_modules/

# SvelteKit build artifacts
.svelte-kit/
build/

# TypeScript build info
*.tsbuildinfo

# Cloudflare Wrangler — local state, dev secrets, build cache
.wrangler/
.dev.vars
.dev.vars.*

# Env / secrets (never commit)
.env
.env.local
.env.*.local

# Sandcastle: directory is committed (prompts, Dockerfile, coding standards),
# but local secrets and runtime state inside it are not.
.sandcastle/.env
.sandcastle/.env.local
.sandcastle/.env.*.local
.sandcastle/state/
.sandcastle/.cache/

# Test output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# IDE / editor
.vscode/
.idea/
.cursor/
.aider*

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor temp
*.swp
*.swo
*~
